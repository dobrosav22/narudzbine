# Copy to .env.local to override. Inlined at build time: restart `pnpm dev` / rebuild after changing it.
#
# Backend base URL including /api/v1. The browser calls it directly with credentials (HttpOnly
# __Host- session cookie + X-CSRF-Token), so it must be https and on the same registrable site as
# this web origin (SameSite=Lax), and this web origin must be in the backend's identity.http.origins.
# Local development: `pnpm dev:api-proxy` serves the synthetic backend on https://localhost:18443.
NEXT_PUBLIC_API_BASE_URL=https://localhost:18443/api/v1

# Google/Apple sign-in buttons on the login page: unset shows both providers the backend supports;
# "GOOGLE", "GOOGLE,APPLE" or an empty value (no buttons) narrows them. Real provider setup is X-02/G-02.
# NEXT_PUBLIC_EXTERNAL_LOGIN_PROVIDERS=GOOGLE,APPLE

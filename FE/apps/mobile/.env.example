# Copy to .env.local to override. Default (unset) = mocks ON.
# "false" routes every service call to packages/core/services/real — anything
# not implemented there yet fails loudly with NOT_IMPLEMENTED (no mock fallback).
# Inlined into the bundle: restart `expo start --clear` after changing it.
EXPO_PUBLIC_USE_MOCKS=true

# ISO 4217 code for every price in the app (default BAM). Formatting is done by
# Intl.NumberFormat from this code — never hardcode a symbol. Also inlined into the bundle.
EXPO_PUBLIC_CURRENCY=BAM

# BCP 47 locale for number/money/date display (default bs-BA → "19,60 KM"), in both UI languages.
# The UI language itself (English / Serbian) is per user, not an env setting.
EXPO_PUBLIC_LOCALE=bs-BA

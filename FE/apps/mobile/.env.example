# Copy to .env.local to override. Inlined at bundle time: restart `expo start` after changing it.
# Absolute backend base URL including /api/v1. Native builds use the NATIVE bearer transport.
#  - Android emulator against the local synthetic backend: http://10.0.2.2:18080/api/v1
#  - Expo web export in a browser: https://localhost:18444/api/v1 (pnpm dev:api-proxy:native)
# Real hosts are X-02 inputs (eas.json uses .invalid placeholders until they exist).
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:18080/api/v1

# HTTPS app link the backend redirects native Google/Apple logins to (must match the backend's
# identity.external.return.android/ios). Unset hides the external sign-in buttons. Real hosts are X-02.
# EXPO_PUBLIC_EXTERNAL_AUTH_RETURN_URL=https://app.example.invalid/android

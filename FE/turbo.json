{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "API_BASE_URL",
    "NEXT_PUBLIC_API_BASE_URL",
    "EXPO_PUBLIC_API_BASE_URL",
    "NEXT_PUBLIC_EXTERNAL_LOGIN_PROVIDERS",
    "EXPO_PUBLIC_EXTERNAL_AUTH_RETURN_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  }
}

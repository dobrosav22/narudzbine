{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "USE_MOCKS",
    "NEXT_PUBLIC_USE_MOCKS",
    "EXPO_PUBLIC_USE_MOCKS",
    "CURRENCY",
    "NEXT_PUBLIC_CURRENCY",
    "EXPO_PUBLIC_CURRENCY",
    "LOCALE",
    "NEXT_PUBLIC_LOCALE",
    "EXPO_PUBLIC_LOCALE"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  }
}
